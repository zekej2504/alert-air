// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- UPDATED: The Parent Company Model ---
model Company {
  id           String     @id @default(uuid())
  name         String     
  contact      String     @unique
  password     String
  adminPhone   String?    // <-- NEW: Admin text number
  adminCarrier String?    // <-- NEW: Admin text carrier
  worksites    Worksite[] 
}

// --- UPDATED: The Worksite Model ---
model Worksite {
  id            String   @id @default(uuid())
  incidentName  String
  state         String
  latitude      Float
  longitude     Float
  foremanPhone  String
  carrier      String?
  crewLeadName  String   @default("Pending")
  isActive      Boolean  @default(true)
  
  // The new multi-tenant link:
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])

// Your existing compliance links:
  signoffs       ComplianceSignoff[]
  airQualityLogs AirQualityLog[]
  signOffs       SignOff[]
  hourlyLogs     HourlyAirLog[]      // <-- Added this to link the new table!
} // <-- This bracket completely closes the Worksite model

model HourlyAirLog {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  worksiteId     String
  worksite       Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  aqi            Int
  status         String   // "SAFE", "VOLUNTARY_LIMIT", or "MANDATORY_LIMIT"
  lawThreshold   Int      // The exact regulatory cutoff at that moment
}

// --- EXISTING: Compliance Logs ---
model ComplianceSignoff {
  id            String   @id @default(uuid())
  worksiteId    String
  logId         String
  signatureHash String   @unique
  createdAt DateTime @default(now())
  worksite      Worksite @relation(fields: [worksiteId], references: [id])
}

model AirQualityLog {
  id            String   @id @default(uuid())
  worksiteId    String
  pm25_aqi      Int
  thresholdMet  Boolean
  
  worksite      Worksite @relation(fields: [worksiteId], references: [id])
}
// --- NEW: State-by-State Regulatory Thresholds ---
model StateRegulation {
  id           String   @id @default(uuid())
  stateCode    String   @unique 
  voluntaryAqi Int?     // AQI when N95s must be PROVIDED
  mandatoryAqi Int?     // AQI when N95s must be ENFORCED
}
// --- NEW: The Legal Compliance Trail ---
model SignOff {
  id        String   @id @default(uuid())
  signature String   // The typed name of the crew lead
  timestamp DateTime @default(now()) // Automatically locks in the exact millisecond
  siteId    String
  site      Worksite @relation(fields: [siteId], references: [id])
}